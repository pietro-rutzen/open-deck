{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Deck",
  "mainBinaryName": "compas-dj",
  "version": "0.1.0",
  "identifier": "org.opendeck.prototype",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Deck \u2014 Comp\u00e1s prototype",
        "width": 1680,
        "height": 1050,
        "minWidth": 1280,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/controllers/*"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyRDA5RTNCMjIyQzBCRDIKUldUU0N5d2lPNTdRZ3I2RHZ1RGRNTStIWTA0V2phR0hma1BiMzF2Y2VqVWJILzhXUUVidkp3TzYK"
    }
  }
}
